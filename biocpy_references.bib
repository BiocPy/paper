@article{lun_powering_2023,
	title = {Powering single-cell analyses in the browser {withWebAssembly}},
	volume = {8},
	rights = {http://creativecommons.org/licenses/by/4.0/},
	issn = {2475-9066},
	url = {https://joss.theoj.org/papers/10.21105/joss.05603},
	doi = {10.21105/joss.05603},
	abstract = {We present kana, a web application for interactive single-cell ’omics data analysis in the browser. Like, literally, in the browser: kana leverages web technologies such as {WebAssembly} to efficiently perform the relevant computations on the user’s machine, avoiding the need to provision and maintain a backend service. The application provides a streamlined one-click workflow for the main steps in a typical single-cell analysis, starting from a count matrix and finishing with marker detection. Results are presented in an intuitive web interface for further exploration and iterative analysis.},
	pages = {5603},
	number = {89},
