\begin_layout Subsection
BiocPy enables interoperability of data objects across frameworks
\end_layout

\begin_layout Standard
The ability to seamlessly transfer data between different frameworks and formats is a key feature of BiocPy.
 This interoperability is particularly important in genomics,
 where researchers often need to use multiple specialized tools for different aspects of their analysis.
\end_layout

\begin_layout Standard
BiocPy provides comprehensive support for interoperability between different data formats and representations,
 enabling researchers to work with genomic data across different tools and environments.
\end_layout

\begin_layout Subsubsection
Converting between BiocFrame and pandas DataFrame
\end_layout

\begin_layout Standard
BiocPy facilitates seamless conversion between BiocFrame and pandas DataFrame objects:
\end_layout

\begin_layout Standard
\begin_inset listings
inline false
status open

\begin_layout Plain Layout

import pandas as pd
\end_layout

\begin_layout Plain Layout

from biocframe import BiocFrame
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Create a pandas DataFrame
\end_layout

\begin_layout Plain Layout

df = pd.DataFrame({
\end_layout

\begin_layout Plain Layout

    "gene_id":
 ["ENSG00000000003",
 "ENSG00000000005",
 "ENSG00000000419"],
\end_layout

\begin_layout Plain Layout

    "gene_name":
 ["TSPAN6",
 "TNMD",
 "DPM1"],
\end_layout

\begin_layout Plain Layout

    "expression":
 [5.2,
 0.0,
 3.7]
\end_layout

\begin_layout Plain Layout

})
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Convert to BiocFrame
\end_layout

\begin_layout Plain Layout

bf = BiocFrame.from_pandas(df)
\end_layout

\begin_layout Plain Layout

print(bf)
\end_layout

\begin_layout Plain Layout

# BiocFrame with 3 rows and 3 columns
\end_layout

\begin_layout Plain Layout

# gene_id gene_name expression
\end_layout

\begin_layout Plain Layout

# <list>   <list>    <list>
\end_layout

\begin_layout Plain Layout

# 0 ENSG00000000003 TSPAN6    5.2
\end_layout

\begin_layout Plain Layout

# 1 ENSG00000000005 TNMD      0.0
\end_layout

\begin_layout Plain Layout

# 2 ENSG00000000419 DPM1      3.7
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

