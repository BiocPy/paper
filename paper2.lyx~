key "lun_beachmat_2018"
literal "false"

\end_inset

,
 which provides a uniform iteration interface over in-memory dense and sparse arrays (accessed in place without copying) as well as delayed or HDF5-backed matrices (streamed in chunks without materializing the full matrix).
 High-level analysis libraries such as 
\begin_inset Flex Code
status open

\begin_layout Plain Layout
libscran
\end_layout

\end_inset


\begin_inset CommandInset citation
LatexCommand cite
key "noauthor_libscran_nodate"
literal "false"

\end_inset

,
 
\begin_inset Flex Code
status open

\begin_layout Plain Layout
