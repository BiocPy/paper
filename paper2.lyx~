\end_layout

\end_inset


\begin_inset CommandInset citation
LatexCommand cite
key "lun_scrapper_2025"
literal "false"

\end_inset

) to pass R matrices and S4 slots into 
\begin_inset Flex Code
status open

\begin_layout Plain Layout
