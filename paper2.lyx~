\end_inset


\begin_inset CommandInset citation
LatexCommand cite
key "noauthor_biocpydelayedarray_2025,pages_delayedarray_2017"
literal "false"

\end_inset

 framework.
 Any experimental container in Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "subsec:Containers-for-Experimental"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

